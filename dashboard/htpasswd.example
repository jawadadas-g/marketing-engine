# Who may open the dashboard. Copy this to `htpasswd`, replace the line, and
# mount it at /etc/nginx/htpasswd. NEVER commit a real one.
#
# Create or add a user (bcrypt, which is what -B means):
#
#   docker run --rm httpd:alpine htpasswd -nbB operator 'a-long-password' >> htpasswd
#
# The line below is the example user `operator` with the password `changeme`.
# It exists so you can see the shape. Do not deploy it.
operator:$2y$05$Qw1x5N7Yk0oPrH3o8Vd9r.rq1O0m0Xh3nJtF3n8HcJ0sQK1mCq9Gm

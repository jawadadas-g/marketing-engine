# Postgres connection for the service (Supabase in deployed environments).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/marketing

# HS256 secret the tenant JWTs are signed with.
JWT_SECRET=dev-secret-change-me

# HTTP port for the Hono service.
PORT=3000

# Separate database used by `npm test`. Tests truncate and migrate it.
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:55432/marketing_test

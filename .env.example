# Postgres connection for the service (Supabase in deployed environments).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/marketing

# HS256 secret the tenant JWTs are signed with.
JWT_SECRET=dev-secret-change-me

# HTTP port for the Hono service.
PORT=3000

# Separate database used by `npm test`. Tests truncate and migrate it.
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:55432/marketing_test

# AES-256-GCM key for provider credentials at rest. Generate with:
#   openssl rand -hex 32
CREDENTIALS_KEY=

# Shared secret in the provider webhook URL: /webhooks/<provider>/<token>.
# Also signs one-click unsubscribe links and is Telegram's setWebhook secret.
WEBHOOK_TOKEN=

# Public origin of this service, used to build unsubscribe links.
PUBLIC_BASE_URL=https://engine.example.com

# Your own domain. Dropped as a company identifier, since it identifies you
# rather than a counterparty.
PLATFORM_DOMAIN=

# Which matching algorithm discovery runs. `basic` is the placeholder.
FINDER=basic

# The marketplace's own key for POST /internal/invites/accept. Not a tenant JWT.
INTERNAL_TOKEN=

# Where /i/<token> sends an invited company to sign up. The token is appended
# as ?invite=<token>.
MARKETPLACE_SIGNUP_URL=https://marketplace.example.com/signup

# Company lookup (Wathq). Unset means lookup is disabled and `enrich` is a
# no-op; the registry simply stores what it is given.
WATHQ_API_KEY=
WATHQ_BASE_URL=https://api.wathq.sa

# Live tests only (npm run test:live). The service never reads these, and each
# provider's suite is skipped unless all of its variables are set.
# WARNING: a configured suite sends a real message to a real person.
TAQNYAT_URL=https://api.taqnyat.sa
TAQNYAT_BEARER=
TAQNYAT_SENDER=
LIVE_SMS_TO=

WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en_US
LIVE_WA_TO=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LIVE_EMAIL_TO=

TG_BOT_TOKEN=
LIVE_TG_CHAT_ID=
